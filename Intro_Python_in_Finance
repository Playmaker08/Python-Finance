import numpy as np
# Derive the equivalent monthly mortgage rate from the annual rate
mortgage_rate_periodic = (1+mortgage_rate)**(1/12) - 1
# How many monthly payment periods will there be over 30 years?
mortgage_payment_periods = 30*12
