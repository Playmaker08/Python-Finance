                      trace=True,
                      error_action='ignore',
                      suppress_warnings=True) 
# Print model summary
print(model2.summary())

# Create model for SARIMAX(p,1,q)(P,1,Q)7
model3 = pm.auto_arima(df3,
                      seasonal=True, m=7,
                      d=1, D=1, 
