                             'std-err': gm_result.std_err, 
                             't-value': gm_result.tvalues})
# Verify t-value by manual calculation
calculated_t = para_summary['parameter']/para_summary['std-err']
# Print calculated t-statistic
print(calculated_t)
# Print parameter stats
print(para_summary)
